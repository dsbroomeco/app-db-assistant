# DB Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env files to git.

# Renderer profiling (optional dev/test flags)
# DBA_RENDER_PROFILER=true
# RUN_PROFILER_HELPER_E2E=true
# RUN_PROFILER_HELPER_DB_E2E=true

# Packaging (disable code-signing auto-discovery for unsigned local builds)
# CSC_IDENTITY_AUTO_DISCOVERY=false
