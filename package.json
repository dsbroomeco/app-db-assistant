{
  "name": "db-assistant",
  "version": "0.2.0",
  "description": "A cross-platform desktop database manager for SQL and NoSQL databases",
  "main": "dist/main/main/main.js",
  "author": {
    "name": "DB Assistant Contributors"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsbroomeco/app-db-assistant.git"
  },
  "scripts": {
    "assets:icons": "node scripts/generate-icons.js",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && electron .",
    "build": "npm run assets:icons && tsc -p tsconfig.main.json && vite build",
    "build:electron": "npm run build && electron-builder",
    "build:win": "npm run build && node -e \"const fs=require('fs');fs.rmSync('node_modules/cpu-features',{recursive:true,force:true});fs.rmSync('node_modules/ssh2/node_modules/cpu-features',{recursive:true,force:true});\" && electron-builder --win",
    "build:linux": "npm run build && node -e \"const fs=require('fs');fs.rmSync('node_modules/cpu-features',{recursive:true,force:true});fs.rmSync('node_modules/ssh2/node_modules/cpu-features',{recursive:true,force:true});\" && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:profile-helper": "RUN_PROFILER_HELPER_E2E=true playwright test tests/e2e/render-profiler-helper.test.ts",
    "test:e2e:profile-helper:db": "RUN_PROFILER_HELPER_E2E=true RUN_PROFILER_HELPER_DB_E2E=true playwright test tests/e2e/render-profiler-helper.test.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "release": "commit-and-tag-version",
    "release:beta": "commit-and-tag-version --prerelease beta",
    "release:dry": "commit-and-tag-version --dry-run",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@tanstack/react-virtual": "^3.14.27",
    "better-sqlite3": "^13.2.0",
    "codemirror": "^6.0.2",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "ioredis": "^6.0.0",
    "mongodb": "^7.9.1",
    "mssql": "^12.8.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "commit-and-tag-version": "^13.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.dbassistant.app",
    "productName": "DB Assistant",
    "copyright": "Copyright © 2025-2026 DB Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "sqlite",
        "name": "SQLite Database",
        "role": "Viewer"
      },
      {
        "ext": "db",
        "name": "Database File",
        "role": "Viewer"
      },
      {
        "ext": "sqlite3",
        "name": "SQLite3 Database",
        "role": "Viewer"
      }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "maintainer": "DB Assistant Contributors <noreply@github.com>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icons",
      "mimeTypes": [
        "application/x-sqlite3",
        "application/vnd.sqlite3"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "db-assistant"
        }
      }
    }
  }
}
